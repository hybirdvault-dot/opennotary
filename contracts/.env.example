# Deployer private key (hex, no 0x prefix required by Foundry). NEVER commit a real key.
PRIVATE_KEY=

# Base Sepolia RPC endpoint (e.g. from Alchemy, Infura, or https://sepolia.base.org).
BASE_SEPOLIA_RPC_URL=

# BaseScan (Etherscan-family) API key used for contract verification.
ETHERSCAN_API_KEY=

# Address that receives the 1-cent protocol fee share of each notarization.
PROTOCOL_TREASURY=

# Address granted DEFAULT_ADMIN_ROLE on the NotaryRegistry.
ADMIN_ADDRESS=

# USDC token address on Base Sepolia (official Circle USDC).
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
