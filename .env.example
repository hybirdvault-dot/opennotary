# ── Public (frontend) ─────────────────────────────────────────────
# Base Sepolia RPC endpoint (Alchemy or https://sepolia.base.org)
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Deployed NotaryRegistry address (Base Sepolia)
NEXT_PUBLIC_NOTARY_REGISTRY_ADDRESS=
# EAS contract (default: EAS on Base Sepolia)
NEXT_PUBLIC_EAS_CONTRACT=0x4200000000000000000000000000000000000021
# EAS schema UIDs (registered at base-sepolia.easscan.org)
NEXT_PUBLIC_EAS_SCHEMA_UID_ACT=
NEXT_PUBLIC_EAS_SCHEMA_UID_NOTARY=

# ── Server-only (API routes — never expose to the browser) ─────────
# Web3.Storage w3up UCAN credentials (https://web3.storage)
# W3_PRINCIPAL: your agent DID (w3 whoami). W3_PROOF: delegation (w3 proof --output proof.ucan)
W3_PRINCIPAL=
W3_PROOF=
# Vercel KV (read-through cache only — source of truth is on-chain)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Relayer key that issues EAS attestations server-side
EAS_RELAYER_PRIVATE_KEY=
# Address receiving the 1-cent protocol fee share
PROTOCOL_TREASURY=
# HMAC-SHA256 signing secret for outbound webhooks (generate: openssl rand -hex 32)
WEBHOOK_SECRET=
# Bearer token required by POST /api/notarize (generate: openssl rand -hex 32)
NOTARIZE_API_TOKEN=
# Bearer token required by POST /api/webhook/outbound (generate: openssl rand -hex 32)
WEBHOOK_API_TOKEN=
# Bearer token required by POST /api/anchor/btc (generate: openssl rand -hex 32)
ANCHOR_API_TOKEN=
